# Hooks run under sh everywhere, so they keep LF line endings.
.githooks/* text eol=lf

# Pack-authoring fixtures are addressed by byte offset; keep them LF on every machine (wing ruling 969).
crates/isocosm-system/tests/fixtures/*.toml text eol=lf
crates/isocosm-system/examples/packs/** text eol=lf

# Edition packs are pinned by content hash (case 1067); one byte form on every machine.
packs/** text eol=lf
