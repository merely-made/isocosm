      {
        "id": "wing:detect",
        "family": "perception",
        "summary": "Read a specified feature through an admitted sense.",
        "limitation": "Specific sight spells filter the existing terrain height tracer per observer; this is not a general supernatural-detection grammar or native sensory allocation.",
        "native": [],
        "mappings": {
          "ars5": {
            "relation": "related",
            "references": [
              "Definitive core: Eyes of the Cat"
            ],
            "differences": [
              "Muto Corpus with Animal requisite, Touch and Sun; permits near-dark vision but not absolute darkness. Calm unmastered formulaic casting is executable."
            ],
            "procedures": [
              "ars5:eyes-of-the-cat"
            ]
          },
          "dnd5-srd51": {
            "relation": "related",
            "references": [
              "Spells: Darkvision"
            ],
            "differences": [
              "Touch a willing creature, eight hours, sixty-foot darkvision; ordinary darkvision cannot pierce magical darkness."
            ],
            "procedures": [
              "dnd5:darkvision"
            ]
          },
          "pf2-player-core": {
            "relation": "related",
            "references": [
              "Player Core: Darkvision; Darkness"
            ],
            "differences": [
              "Rank two is personal for one hour; rank three permits touch; rank five lasts until daily preparations. Heightened magical darkness can defeat ordinary darkvision."
            ],
            "procedures": [
              "pf2:darkvision"
            ]
          }
        }
      },
