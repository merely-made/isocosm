      {
        "id": "wing:grow-body",
        "family": "anatomy",
        "summary": "Grow the next parts of an admitted body recipe from paid material.",
        "limitation": "Native growth fills or adds recipe parts and accounts for matter. It does not resize existing extents, replace a stat block, merge equipment or implement temporary polymorph.",
        "native": [
          {
            "operation": "grow",
            "function": null
          }
        ],
        "mappings": {
          "ars5": {
            "relation": "related",
            "references": [
              "Hermetic magic: Muto Corpus and Muto Animal guidelines"
            ],
            "differences": [
              "Transformation guidelines and their limits are separate from native development. Technique, Form, requisites, magnitude, Range, Duration and Target are not inferred from a growth cost."
            ]
          },
          "dnd5-srd51": {
            "relation": "related",
            "references": [
              "Spells: Enlarge/Reduce; Polymorph"
            ],
            "differences": [
              "These spells specify distinct size or form changes and their own reversions and statistics. Recipe growth is a lasting material process; those procedures require separate bindings."
            ]
          },
          "pf2-player-core": {
            "relation": "related",
            "references": [
              "Spells: Enlarge; Animal Form; polymorph trait"
            ],
            "differences": [
              "A battle form's statistics and limitations are edition-native. Paid growth supplies neither battle-form statistics nor temporary size and reach adjustments."
            ]
          }
        }
