      {
        "id": "wing:enchant",
        "family": "persistence",
        "summary": "Attach a lasting, addressable magical change to a bearer.",
        "limitation": "Nine-spell VTT tranche supplies an addressable lifecycle and lasting weapon changes; permanent device creation and native biological magic remain unbound. Base state is projected, not rolled back.",
        "native": [],
        "mappings": {
          "ars5": {
            "relation": "related",
            "references": [
              "Definitive core: Edge of the Razor; formulaic casting and Sun duration; laboratory enchanted devices are separate"
            ],
            "differences": [
              "Investing a device and casting a sustained spell are separate procedures. Laboratory work, resources, triggers and effect frequency are retained as edition-specific requirements."
            ],
            "procedures": [
              "ars5:edge-of-the-razor"
            ]
          },
          "dnd5-srd51": {
            "relation": "related",
            "references": [
              "Spells: Magic Weapon; spell duration and concentration"
            ],
            "differences": [
              "A temporary weapon spell and a permanent magic item have different procedures. Preserve target, modifiers, concentration, expiry and dispelling; no common lifetime is selected here."
            ],
            "procedures": [
              "dnd5:magic-weapon"
            ]
          },
          "pf2-player-core": {
            "relation": "related",
            "references": [
              "Spells: Runic Weapon"
            ],
            "differences": [
              "Runic Weapon's temporary weapon changes and heightened effects belong to that spell. The catalogue does not equate them with permanent runes or another edition's bonuses."
            ],
            "procedures": [
              "pf2:runic-weapon"
            ]
          }
        }
      },
