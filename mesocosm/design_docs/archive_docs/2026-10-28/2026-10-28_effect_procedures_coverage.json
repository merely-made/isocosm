    "entries": [
      {
        "id": "wing:allocate-sense",
        "family": "perception",
        "summary": "Allocate living cells to an existing sensory function.",
        "limitation": "Native allocation changes a declared organ's functional cells; it does not grant darkvision, a new modality, a greater sight radius or an edition's spell procedure.",
        "native": [
          {
            "operation": "allocate",
            "function": "function:sense"
          }
        ],
        "mappings": {
          "ars5": {
            "relation": "related",
            "references": [
              "Supplemental Spell Guidelines: Intellego Animal, supernatural-creature detection"
            ],
            "differences": [
              "Intellego detection reads a specified subject under its guidelines. Allocating native sensory tissue does not implement an Intellego effect, its target or its casting method."
            ]
          },
          "dnd5-srd51": {
            "relation": "related",
            "references": [
              "Spells: Darkvision"
            ],
            "differences": [
              "Darkvision grants a specified kind of sight for a duration; native allocation is anatomical and grants no darkvision semantics. Casting, target restrictions, range and duration remain edition-owned."
            ]
          },
          "pf2-player-core": {
            "relation": "related",
            "references": [
              "Spells: Darkvision; senses: darkvision"
            ],
            "differences": [
              "The edition grants a named sense with spell-specific duration and heightened behaviour. Native sensing cells are only an anatomical candidate, not that sense or its casting procedure."
            ]
          }
        }
      },
