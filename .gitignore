# Every workspace's build output, nested ones included (host/ had none).
target/
/target-*/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# sem (Ataraxy-Labs) semantic-diff index cache — local, never committed.
.sem/

# Machine-local cargo overrides (source-specific [patch] to local genet
# checkouts, the mere pattern). Never committed.
.cargo/config.toml
.cargo/tabletop-local.toml
/maps/
# Not tracked: what cargo resolved is a git note on each commit (scripts/record-resolved.sh).
Cargo.lock
