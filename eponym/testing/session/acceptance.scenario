# Eponym session acceptance (document-host plan P3b). Run from eponym/:
#   cargo run -p eponym-client --bin session --target-dir target-contact -- \
#     --scenario testing/session/acceptance.scenario \
#     --receipt <out>/acceptance.json --capture <out>/acceptance.png \
#     --frames 1800 --size 1240x820
# Every click goes through the host's own retained DOM and pointer routing.
# Everything with no DOM control of its own is an `act`, which is this host's
# keyboard-only vocabulary by name. Every checkpoint verb is wing-scenario's:
# `remember` takes one, and `same`/`differs`/`more`/`dropped` read it back.
wait
assert snap ready == yes
assert snap error == none
assert snap viewport-error == none
assert text Subject sheet
assert text Equipment
assert text Acquisition journal
assert text Status
capture opened
remember start

# Movement reaches the accepted world, not just the drawn frame.
act move-right
settle 3
assert event motion-advanced
differs start position hash
more start step
assert snap grounded == yes

# The charged volley: aim, join a limb, charge, release. The target loses the
# authored limb it wears the dressing on.
remember before-volley
act aim-right
settle 2
assert snap action == Right
act join-2
act charge
settle 2
act strike
settle 3
assert event volley-resolved
assert snap target-parts ~ severed
dropped before-volley target-vitality
differs before-volley hash
capture volleyed
viewport-pixels-change opened volleyed

# The acquisition journal reads the same accepted volley: a new glyph, named
# in the panel, with the strike as its evidence.
more before-volley glyphs
assert snap glyph-last == paredros-fixture:strike
assert text paredros-fixture:strike

# Hagioglyph: the world publishes a newer correspondence. What the strike was
# acquired under does not move; what it now means does. The act is a fixture
# control with a fixed seed, not a product action.
remember before-revision
assert snap canon-revision == 1
assert text paredros-fixture:reach
act revise-canon
settle 2
assert event canon-revised
differs before-revision canon-revision
same before-revision glyph-last
same before-revision glyphs
differs before-revision glyph-last-live-effect
assert snap glyph-last-live-effect == paredros-fixture:fasten
assert text paredros-fixture:reach

# Treatment through the controls themselves. The injury debug has no button of
# its own, so it is the one act between the two clicks.
click role:button Take dressing
settle 2
act injure
settle 2
assert event anatomy-reconciled
remember before-rest
click role:button Rest
settle 3
assert event rested
more before-rest glyphs
assert snap glyph-last == paredros-fixture:mend
assert text paredros-fixture:mend
assert snap wound == 0
assert snap lost-parts == 1

# A part button in the sheet names the same identity a viewport pick does.
click role:button gripping limb C
settle 2
assert snap selected-subject == 701
assert snap selected-part == 3

# Save and load round-trip the accepted world through one GameSave version.
click role:button Save
settle 2
assert snap saves == 1
remember saved
act move-forward
settle 2
differs saved position hash
click role:button Load
settle 3
assert snap save-loaded == yes
same saved hash
capture final
